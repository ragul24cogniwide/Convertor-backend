# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0

# Privacy & Security
# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=100

# Ephemeral File Retention
# Automatic deletion TTL for uploaded and converted files (in minutes)
TEMP_FILE_TTL_MINUTES=30

# Interval for background cleanup worker (in minutes)
CLEANUP_INTERVAL_MINUTES=5

# Subprocess timeout in seconds (for LibreOffice / OCR / external utilities)
CONVERSION_TIMEOUT_SECONDS=120

# CORS settings (comma-separated list of allowed origins)
CORS_ORIGINS=https://convertor-frontend.vercel.app,http://localhost:5173,http://localhost:3000

# Path to temporary storage (relative to backend root or absolute)
TEMP_DIR=temp
